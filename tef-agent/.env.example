# Backend que comanda este agente. O agente abre a conexão para fora, então
# o Pi não precisa de IP público nem porta liberada.
BACKEND_URL=https://api.promptpag.com
# Mesmo valor do TEF_AGENT_TOKEN no .env do backend.
AGENT_TOKEN=troque-este-token

# Identidade deste totem.
AGENT_ID=totem-01
LAUNDRY_ID=lavanderia-piloto

# AutoTEF Slim na mesma máquina.
AUTOTEF_URL=http://127.0.0.1:8000
STONE_CODE=206192723
PARTNER_NAME=Joilson Leal Bica
PINPAD_PORT=/dev/ttyACM0

# true quando o appsettings.json do Slim está com IsPdv=true.
AUTOTEF_IS_PDV=true

# Ativa o Slim ao subir (carga de tabelas). Só desligue para depurar.
ACTIVATE_ON_BOOT=true

# Sondagem do pinpad. O healthcheck do Slim conversa com o device pela
# serial, então NÃO é de graça: consultar sem parar acorda a maquininha à
# toa. lazy = só na inicialização e depois de uma falha (recomendado).
# interval = de tempos em tempos, quando ocioso. off = só se o backend pedir.
HEALTHCHECK_MODE=lazy
HEALTHCHECK_MIN_INTERVAL_MS=600000
HEALTHCHECK_MIN_GAP_MS=60000

# info | debug | warn | error
LOG_LEVEL=info
